# Copy to .env and adjust. All values are optional; defaults are shown.

# SQLite (local dev). The path is relative to the directory uvicorn is started from.
DATABASE_URL=sqlite:///./payments.db
# PostgreSQL (requires `pip install "psycopg[binary]"`):
# DATABASE_URL=postgresql+psycopg://payments:secret@localhost:5432/payments

# Transactions with amount strictly greater than this are FLAGGED for review.
FLAG_THRESHOLD=10000

# Insert 8 sample transactions on startup when the table is empty.
SEED_ON_STARTUP=true

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
